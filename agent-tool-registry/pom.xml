<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>FirstAgentProject</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-tool-registry</artifactId>

    <!--
        模块定位：工具注册中心（D67）

        依赖原则：
          ① 只依赖 spring-ai-model —— 需要 ToolCallback / ToolDefinition
          ② 只依赖 spring-boot-starter —— 为了 @Component（InMemoryToolRegistry）
          ③ 绝不依赖任何业务模块（agent-tools / agent-core / agent-mcp-server）

        这样定位的好处：
          - agent-core 可以用它
          - agent-mcp-server 未来也可以用它
          - 其他团队想复用工具治理能力，直接引这个 pom 即可
    -->

    <dependencies>

        <!-- ============================================================
             ① spring-ai-model —— ToolCallback / ToolDefinition
             注意用 spring-ai-model 而不是 spring-ai-starter-model-openai：
             注册中心只做工具治理，不需要任何具体的模型实现。
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- ============================================================
             ② spring-boot-starter —— 为了 @Component / @Configuration
             不需要 web / jdbc / redis —— 纯 Java 逻辑 + Spring 容器支持。
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- ============================================================
             ③ Lombok —— @Slf4j
             ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

</project>