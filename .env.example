# ============================================================
# D78：环境变量样板
# ------------------------------------------------------------
# 用法：
#   1. cp .env.example .env
#   2. 填入真实值（.env 加入 .gitignore）
#   3. docker-compose / IDE / K8s 都从这里读取
#
# 安全约定：
#   - 本文件可提交，含默认/占位值
#   - .env 不提交，含真实密钥
# ============================================================

# ---------- LLM 供应商 ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ---------- 基础设施连接 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=rag
MYSQL_USER=rag
MYSQL_PASSWORD=rag123456

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT__SERVICE__API_KEY=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fap
RABBITMQ_PASSWORD=fap123456
RABBITMQ_VHOST=/fap

# ---------- RAG 存储路径 ----------
RAG_FILE_STORAGE_DIR=./data/rag-files/
RAG_LISTEN_FILES_DIR=./data/testVectorData/
RAG_SCAN_INTERVAL_MS=3000000
RAG_INCREMENTAL_ENABLED=true

# ---------- 远程重排 ----------
TEI_RERANK_URL=http://localhost:8081/rerank

# ---------- 观测 ----------
TRACING_SAMPLING=0.1
ZIPKIN_ENDPOINT=https://*************/zipkin/api/v2/spans

# ---------- 应用端口 ----------
AGENT_API_PORT=8080
MCP_SERVER_PORT=8086
TEI_PORT=8081

# ---------- 镜像版本 ----------
FAP_VERSION=1.0.0

# ---------- Spring Profile ----------
SPRING_PROFILES_ACTIVE=dev