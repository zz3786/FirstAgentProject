<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>FirstAgentProject</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-core</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- core 依赖 tools 和 memory -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- ============================================================
     MCP Client Starter（D66）
     作用：
       - 自动装配 McpSyncClient，连接 yml 里配置的 MCP Server
       - initialize 握手、Session 管理、tools/list 拉取全部自动完成
       - 把每个 MCP Tool 包装成 ToolCallback，注册为 ToolCallbackProvider
     注意：这个 Starter 会传递引入 OpenAiAutoConfiguration，
     但 agent-core 已经引入过 spring-ai-starter-model-openai，
     不产生新的自动配置要求。
     ============================================================ -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- ============================================================
             agent-tool-registry —— D67 工具注册中心
             ChatService、PlanValidator、ToolRegistrationBootstrap
             都依赖注册中心的接口和实现。
             ============================================================ -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>agent-tool-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>

    </dependencies>

</project>