<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.rag.mapper.RagChunkMapper">

    <resultMap id="BaseResultMap" type="org.example.rag.entity.RagChunk">
        <id     column="id"          property="id"/>
        <result column="doc_id"      property="docId"/>
        <result column="chunk_index" property="chunkIndex"/>
        <result column="source"      property="source"/>
        <result column="content"     property="content"/>
        <result column="file_path"   property="filePath"/>
        <result column="created_at"  property="createdAt"/>
        <!-- score 不是表字段，查询时动态填充 -->
        <result column="score"       property="score"/>
        <!-- ★ D46 新增 -->
        <result property="department"  column="department"/>
        <result property="year"        column="year"/>
        <result property="contentType" column="content_type"/>
        <result property="securityLevel"  column="security_level"/>
        <result property="status"         column="status"/>

        <result column="page_number"  property="pageNumber"/>
        <result column="total_chunks" property="totalChunks"/>
    </resultMap>

    <!-- ==================== 批量插入（入库时用） ==================== -->
    <insert id="batchInsert">
        INSERT INTO rag_chunks
        (doc_id, chunk_index, source, content, file_path,
        department, year, content_type,
        security_level, status,                          <!-- ★ 新增 -->
        page_number,          <!-- ★ 新增 -->
        total_chunks,         <!-- ★ 新增 -->
        created_at)
        VALUES
        <foreach collection="list" item="c" separator=",">
            (#{c.docId}, #{c.chunkIndex}, #{c.source}, #{c.content}, #{c.filePath},
            #{c.department}, #{c.year}, #{c.contentType},
            #{c.securityLevel}, #{c.status},#{item.pageNumber}, #{item.totalChunks}
            NOW())
        </foreach>
    </insert>

