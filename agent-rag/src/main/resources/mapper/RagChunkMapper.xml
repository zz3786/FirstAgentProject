    <!-- ==================== 关键词检索（带过滤）★ D46 新增 ==================== -->
    <!--
        ★ 关键设计说明：

        ① 为什么用 <if> 而不是 <choose>：
           过滤条件是"可选的、可组合的"——调用方可能只传部门，
           也可能同时传部门+年份+类型。用 <if> 拼接最自然。

        ② 为什么 departments / docTypes 用 <foreach> 而不是 <if>：
           IN 子句的语法要求参数列表展开成 (?, ?, ?)。
           用 <foreach> 动态生成占位符。

        ③ 为什么 yearFrom/yearTo 分开判断：
           允许只传下界、只传上界、或两边都传。
           联合写成 BETWEEN 会丢失灵活性。

        ④ MATCH AGAINST 必须在 WHERE 里而非 SELECT 里：
           MySQL 要求全文检索出现在 WHERE 子句，否则报错。
           SELECT 里的那一份只是为了取 score 字段。

        ⑤ ORDER BY score DESC：
           相关度降序。当过滤条件命中很多文档时，
           相关度最高的排前面，便于后续 TEI 重排采样。
    -->
    <select id="fulltextSearchWithFilter" resultMap="BaseResultMap">
        SELECT
        id, doc_id, chunk_index, source, content, file_path,
        department, year, content_type, security_level, status,
        page_number,total_chunks,created_at,
        MATCH(content) AGAINST(#{query} IN BOOLEAN MODE) AS score
        FROM rag_chunks
        WHERE MATCH(content) AGAINST(#{query} IN BOOLEAN MODE)

        <!-- ★ 部门级可见性：
              - department IN (用户部门) → 本部门文档，可见
              - department IS NULL       → 公开文档，所有部门可见
              - 其他部门文档 → 自动被 IN 排除 -->
        <if test="departments != null and departments.size() > 0">
            AND (
            department IN
            <foreach collection="departments" item="d" open="(" close=")" separator=",">
                #{d}
            </foreach>
            )
        </if>

        <!-- ★ 年份：null = 不限年份，放行 -->
        <if test="yearFrom != null">
            AND (year &gt;= #{yearFrom} OR year = 0 )
        </if>
        <if test="yearTo != null">
            AND (year &lt;= #{yearTo} OR year = 0)
        </if>

        <!-- ★ 内容类型：null = 未分类，放行 -->
        <if test="docTypes != null and docTypes.size() > 0">
            AND (
            content_type IN
            <foreach collection="docTypes" item="t" open="(" close=")" separator=",">
                #{t}
            </foreach>
            OR content_type IS NULL
            )
        </if>

        <!-- ★ 密级：与部门正交的第二道权限，null 拒绝 -->
        <if test="securityLevelMax != null">
            AND security_level IS NOT NULL
            AND security_level &lt;= #{securityLevelMax}
        </if>

        <!-- ★ 状态：null 拒绝（防作废/草稿漏出） -->
        <if test="statuses != null and statuses.size() > 0">
            AND status IN
            <foreach collection="statuses" item="s" open="(" close=")" separator=",">
                #{s}
            </foreach>
        </if>

        ORDER BY score DESC
        LIMIT #{topK}
    </select>

    <!-- 按 docId 删除 -->
    <delete id="deleteByDocId">
        DELETE FROM rag_chunks WHERE doc_id = #{docId}
    </delete>

    <!-- 统计 -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM rag_chunks
    </select>

</mapper>